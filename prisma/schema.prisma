generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  username        String    @unique
  phone           String
  role            Role      @default(GUEST)
  avatar          String?
  bio             String?
  password        String    @default("")
  updatedAt       DateTime  @default(now())
  resetToken      String?
  restTokenExpiry DateTime?
  cratedAt        DateTime  @default(now())
  bookings        Booking[]
  listings        Listing[]
  reviews         Review[]
}

model Listing {
  id            Int         @id @default(autoincrement())
  title         String
  description   String
  location      String
  pricePerNight Float
  guests        Int
  type          ListingType
  amenities     String[]
  photos        String[]
  rating        Float?
  cratedAt      DateTime    @default(now())
  updatedAt     DateTime    @default(now())
  hostId        Int
  bookings      Booking[]
  host          User        @relation(fields: [hostId], references: [id])
  reviews       Review[]

  @@index([location])
  @@index([pricePerNight])
  @@index([type])
  @@index([hostId])
  @@index([type, location])
}

model Booking {
  id         Int           @id @default(autoincrement())
  chekin     DateTime
  checkout   DateTime
  totalPrice Float
  status     BookingStatus
  createdAt  DateTime      @default(now())
  guestId    Int
  listingId  Int
  guest      User          @relation(fields: [guestId], references: [id])
  listing    Listing       @relation(fields: [listingId], references: [id])

  @@index([guestId])
  @@index([listingId])
  @@index([listingId, chekin, checkout])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  userId    Int
  listingId Int
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ListingType {
  APARTMENT
  HOUSE
  VILLA
  CABIN
}

enum Role {
  ADMIN
  HOST
  GUEST
}
